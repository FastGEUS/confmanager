# Copy to /etc/confmanager/app.env on app-srv, never commit the real file.
# Replace the address and both secret placeholders.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg2://confuser:REPLACE_DB_PASSWORD@192.168.142.11:5432/confmanager?connect_timeout=5
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Use the actual Host-only address of app-srv.
APP_HOST=192.168.142.10
APP_PORT=8000
